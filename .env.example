# ─────────────────────────────────────────────
# Supabase Postgres (projeto: awhkqwccbqgddyabwrtq)
# ─────────────────────────────────────────────
# Para desenvolvimento local: use a "Direct connection" (porta 5432)
# Para produção (Vercel/serverless): use o "Transaction pooler" (porta 6543)
#
# Como obter: Supabase → Settings → Database → Connection string
# Selecione "Transaction pooler" e copie a URL, trocando [YOUR-PASSWORD]
#
DATABASE_URL=postgresql://postgres.awhkqwccbqgddyabwrtq:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────
# Vercel Blob (storage de imagens)
# ─────────────────────────────────────────────
# Obtido automaticamente ao conectar a integration no Vercel, ou:
#   vercel env pull  (localmente com CLI do Vercel)
#
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────
ADMIN_USERNAME=admin

# Gerar hash da senha em base64 (evita problemas com $ no dotenv):
#   npm run admin:hash -- 'sua-senha'
# O script já imprime o valor base64 pronto para colar aqui.
ADMIN_PASSWORD_HASH_B64=

# Chave de sessão JWT — mínimo 32 caracteres aleatórios:
#   openssl rand -base64 48
SESSION_SECRET=
